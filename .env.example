MYSQL_ROOT_PASSWORD=SuaSenhaDoBanco
DATABASE=db_cartoes
# Porta do seu computador ligada ao MySQL do container (ex: 3308)
MYSQL_HOST_PORT=3308
# Porta do seu computador ligada à aplicação (padrão 80; use 5000 se a 80 estiver ocupada)
APP_HOST_PORT=80
ADMIN_PASSWORD=SenhaParaAcessoAdministrativo
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=ColeAquiAChaveGerada
DB_HOST="mysql"
DB_USER="root"
DB_PASSWORD="${MYSQL_ROOT_PASSWORD}"
DB_NAME="${DATABASE}"
DB_PORT="3306"
